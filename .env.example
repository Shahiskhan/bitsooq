# Use scripts/new-local-env.ps1 to create random LOCAL credentials.
# Production secrets belong in a secret manager, never this repository.
FIREBASE_PROJECT_ID=
INTERNAL_HMAC_SECRET=
CONFIG_USERNAME=config
CONFIG_PASSWORD=
EUREKA_USERNAME=discovery
EUREKA_PASSWORD=
MYSQL_ROOT_PASSWORD=
USER_DB_PASSWORD=
PRODUCT_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
REDIS_PASSWORD=

# Firebase web configuration is public client configuration, never a service-account key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Only needed with docker-compose.firebase-admin.yml; keep actual key outside the repository.
FIREBASE_ADMIN_CREDENTIALS_FILE=

# ---- BitSooq hybrid payments ----
# Moyasar (Mada / Visa / MasterCard / Apple Pay). Secret key lives ONLY in env/secrets.
MOYASAR_BASE_URL=https://api.moyasar.com/v1
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_DB_PASSWORD=

# Crypto gateway (no smart contracts — plain native/ERC-20 transfers to the merchant wallet).
# Use a public RPC (Alchemy/Infura) for ethereum-sepolia or polygon-amoy testnets.
CRYPTO_RPC_URL=https://ethereum-sepolia.g.alchemy.com/v2/YOUR_KEY
CRYPTO_MERCHANT_WALLET=0x0000000000000000000000000000000000000000
CRYPTO_BETA_ENABLED=false
CRYPTO_DB_PASSWORD=

# Optional single-node MySQL server for local schema work only (port 3307).
COMMERCE_DEV_DB_ROOT_PASSWORD=
